{
  "expo": {
    "name": "BaristaOne",
    "slug": "baristaone-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamilertap.baristaone",
      "infoPlist": {
        "NSCameraUsageDescription": "BaristaOne masa QR kodlarını okutmak için kamerayı kullanır."
      }
    },
    "android": {
      "package": "com.kamilertap.baristaone",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8fafc"
      },
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#f8fafc",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ]
  }
}