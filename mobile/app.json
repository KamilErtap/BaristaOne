{
  "expo": {
    "name": "BaristaOne",
    "slug": "baristaone-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamilertap.baristaone",
      "infoPlist": {
        "NSCameraUsageDescription": "BaristaOne masa QR kodlarını okutmak için kamerayı kullanır."
      }
    },
    "android": {
      "package": "com.kamilertap.baristaone",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8fafc"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7affb841-e1ea-4fa9-b78b-d2d21391f80f"
      }
    },
    "owner": "kamil32500"
  }
}
